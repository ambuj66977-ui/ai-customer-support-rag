# Use "local" for the no-key default or "openai" for the API adapter.
LLM_PROVIDER=local
LOCAL_LLM_MODEL=google/flan-t5-small

# OpenAI answer generation (needed only when LLM_PROVIDER=openai)
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Retrieval configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=3
MIN_SIMILARITY=0.35
